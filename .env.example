# =============================================================
# EIDH — Enterprise Innovation & Delivery Hub
# Environment template (committed). Copy to `.env` for local dev:
#
#   cp .env.example .env     (Windows: copy .env.example .env)
#
# Stack: Node.js + React + Turso (libSQL) + AI copilot layer
# =============================================================

# ---- Application ----
NODE_ENV=development
PORT=4000

# ---- Turso / libSQL database ----
# Database URL: libsql://<database>-<org>.turso.io
TURSO_DATABASE_URL=

# Auth token: from `turso db tokens create <db>` or the Turso dashboard
TURSO_AUTH_TOKEN=

# ---- AI / LLM provider (primary) ----
# Provider: openai | azure_openai | anthropic | ollama | deepseek | meta | xai
AI_PROVIDER=

# Base URL of the AI service
#   - OpenAI/Anthropic: optional (leave empty for the default endpoint)
#   - Azure OpenAI: the deployment endpoint base URL
#   - Ollama (local): http://localhost:11434/v1
#   - DeepSeek: https://api.deepseek.com/v1
#   - Meta: https://api.meta.ai/v1
#   - xAI: https://api.x.ai/v1
AI_BASE_URL=

# Model identifier (e.g. gpt-4o-mini, claude-3-5-sonnet, deepseek-chat)
AI_MODEL=

# API key for the AI provider
AI_API_KEY=

# ---- Additional AI providers (optional, one per model) ----
# Each additional model uses the suffixed forms AI_PROVIDER2/3/4,
# AI_BASE_URL2/3/4, AI_MODEL2/3/4, AI_API_KEY2/3/4.
# AI_PROVIDER2=
# AI_BASE_URL2=
# AI_MODEL2=
# AI_API_KEY2=
# AI_PROVIDER3=
# AI_BASE_URL3=
# AI_MODEL3=
# AI_API_KEY3=

# ---- Model catalog (Application Idea Generator drop-down) ----
# Comma-separated list of model IDs exposed in the UI. First = default.
# e.g. AI_MODELS=deepseek-chat,gpt-4o-mini,claude-3-5-sonnet
AI_MODELS=

# ---- Optional (uncomment as needed) ----
# JWT_SECRET=
# CLERK_SECRET_KEY=
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=
